<?xml version="1.0"?>
<sdf version="1.9">
  <world name="office">
    <!-- Generated by make_office.py: edit the numbers there and re-run, rather than editing here. -->
    <!-- Room 14.84 m x 4.48 m. Robot spawns at world (0,0). Door centres in world coordinates: -->
    <!-- door_5: x=0.50 y=-2.20 -->
    <!-- door_6: x=-1.50 y=-1.30 -->
    <!-- door_7: x=-1.50 y=0.00 -->
    <!-- door_8: x=-1.50 y=1.30 -->
    <!-- door_9: x=13.34 y=1.70 -->
    <!-- door_10: x=13.34 y=0.80 -->
    <!-- door_1: x=14.34 y=-3.20 -->
    <!-- door_4: x=14.34 y=-0.30 -->
    <!-- door_2: x=16.54 y=-2.40 -->
    <!-- door_3: x=16.54 y=-1.10 -->

    <!-- 4 ms physics step (default is 1 ms): 4x less physics work, plenty for a velocity-controlled robot -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.78 0.7 1</ambient><diffuse>0.8 0.78 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_end_a">
      <static>true</static>
      <pose>-1.500 0.040 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.100 4.480 2.000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.100 4.480 2.000</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
